// Statement parameters built up one by one: tx.exec(sql, pqxx::params{a, b}).
class params {
 public:
  params() = default;
  template <class... A>
  explicit params(const A&... args) {
    (append(args), ...);
  }
  template <class T>
  void append(const T& v) {
    if constexpr (std::is_same_v<std::decay_t<T>, params>) {
      for (const auto& p : v.list_) list_.push_back(p);
    } else {
      list_.push_back(lb::pg::to_param(v));
    }
  }
  void append() { list_.push_back({std::nullopt, 'n'}); }
  template <class R>
  void append_multi(const R& range) {
    for (const auto& v : range) append(v);
  }
  int size() const noexcept { return static_cast<int>(list_.size()); }
  const std::vector<lb::pg::Param>& lb_list() const { return list_; }

 private:
  std::vector<lb::pg::Param> list_;
};

// A prepared statement's name, for tx.exec(pqxx::prepped{"name"}, params).
class prepped {
 public:
  explicit prepped(std::string name) : name_(std::move(name)) {}
  explicit prepped(const char* name) : name_(name) {}
  const std::string& name() const { return name_; }

 private:
  std::string name_;
};

namespace internal {

template <class... A>
std::vector<lb::pg::Param> params_of(const A&... args) {
  std::vector<lb::pg::Param> out;
  out.reserve(sizeof...(A));
  (
      [&] {
        if constexpr (std::is_same_v<std::decay_t<A>, params>) {
          for (const auto& p : args.lb_list()) out.push_back(p);
        } else {
          out.push_back(lb::pg::to_param(args));
        }
      }(),
      ...);
  return out;
}

// Text as a value of T (libpqxx's from_string); what cannot convert throws conversion_error.
long long parse_integer(std::string_view text, const char* type);
unsigned long long parse_unsigned(std::string_view text, const char* type);
double parse_float(std::string_view text);
bool parse_bool(std::string_view text);
std::string parse_bytea(std::string_view text);
std::string type_name(const char* mangled);

template <class T>
struct is_optional : std::false_type {};
template <class T>
struct is_optional<std::optional<T>> : std::true_type {};

}  // namespace internal

// Convert a field's text to T (libpqxx's string conversion).
template <class T>
T from_string(std::string_view text) {
  using D = std::decay_t<T>;
  if constexpr (std::is_same_v<D, bool>) {
    return internal::parse_bool(text);
  } else if constexpr (std::is_same_v<D, char>) {
    if (text.size() != 1) throw conversion_error("Could not convert string to char: '" + std::string(text) + "'.");
    return text[0];
  } else if constexpr (std::is_integral_v<D> && std::is_signed_v<D>) {
    const long long v = internal::parse_integer(text, internal::type_name(typeid(D).name()).c_str());
    if (v < static_cast<long long>(std::numeric_limits<D>::min()) || v > static_cast<long long>(std::numeric_limits<D>::max()))
      throw conversion_overrun("Value out of range for " + internal::type_name(typeid(D).name()) + ": '" + std::string(text) + "'.");
    return static_cast<D>(v);
  } else if constexpr (std::is_integral_v<D>) {
    const unsigned long long v = internal::parse_unsigned(text, internal::type_name(typeid(D).name()).c_str());
    if (v > static_cast<unsigned long long>(std::numeric_limits<D>::max()))
      throw conversion_overrun("Value out of range for " + internal::type_name(typeid(D).name()) + ": '" + std::string(text) + "'.");
    return static_cast<D>(v);
  } else if constexpr (std::is_floating_point_v<D>) {
    return static_cast<D>(internal::parse_float(text));
  } else if constexpr (std::is_same_v<D, std::string>) {
    return std::string(text);
  } else if constexpr (std::is_same_v<D, std::string_view>) {
    return text;
  } else if constexpr (std::is_same_v<D, bytes>) {
    const std::string raw = internal::parse_bytea(text);
    return bytes(reinterpret_cast<const std::byte*>(raw.data()), raw.size());
  } else {
    static_assert(sizeof(D) == 0, "pqxx: no string conversion to this type");
  }
}

// A value as a parameter's text (libpqxx's to_string).
template <class T>
std::string to_string(const T& v) {
  const lb::pg::Param p = lb::pg::to_param(v);
  if (!p.text) throw conversion_error("Attempt to convert null to a string.");
  return *p.text;
}

