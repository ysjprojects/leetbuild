class field {
 public:
  using size_type = std::size_t;
  field() = default;
  field(std::shared_ptr<const internal::result_data> data, int row, int col) : data_(std::move(data)), row_(row), col_(col) {}

  bool is_null() const noexcept { return !cell().has_value(); }
  const char* c_str() const& { return is_null() ? "" : cell()->c_str(); }
  std::string_view view() const& { return is_null() ? std::string_view() : std::string_view(*cell()); }
  size_type size() const noexcept { return is_null() ? 0 : cell()->size(); }
  const char* name() const { return data_->r.columns.at(static_cast<size_t>(col_)).name.c_str(); }
  oid type() const { return data_->r.columns.at(static_cast<size_t>(col_)).oid; }
  int num() const { return col_; }
  int column_number() const { return col_; }
  int rownumber() const { return row_; }

  // The value as T; NULL throws (as<std::optional<T>>() gives nullopt).
  template <class T>
  T as() const {
    if constexpr (internal::is_optional<T>::value) {
      if (is_null()) return std::nullopt;
      return as<typename T::value_type>();
    } else {
      if (is_null()) null_error(internal::type_name(typeid(T).name()));
      if constexpr (std::is_same_v<T, const char*>) {
        return cell()->c_str();
      } else {
        return from_string<T>(*cell());
      }
    }
  }
  // The value as T, or fallback when NULL.
  template <class T>
  T as(const T& fallback) const {
    return is_null() ? fallback : as<T>();
  }
  // The value, or nullopt when NULL.
  template <class T>
  std::optional<T> get() const {
    if (is_null()) return std::nullopt;
    return as<T>();
  }
  // Read into out; false (out untouched) when NULL.
  template <class T>
  bool to(T& out) const {
    if (is_null()) return false;
    out = as<T>();
    return true;
  }
  template <class T>
  bool to(T& out, const T& fallback) const {
    const bool has = to(out);
    if (!has) out = fallback;
    return has;
  }
  template <class T>
  bool operator>>(T& out) const {
    return to(out);
  }
  bool operator==(const field& other) const { return is_null() == other.is_null() && view() == other.view(); }

 private:
  [[noreturn]] void null_error(const std::string& type) const;
  const std::optional<std::string>& cell() const {
    return data_->r.rows.at(static_cast<size_t>(row_)).at(static_cast<size_t>(col_));
  }
  std::shared_ptr<const internal::result_data> data_;
  int row_ = 0;
  int col_ = 0;
};

class row {
 public:
  using size_type = int;
  using reference = field;

  class const_iterator {
   public:
    using iterator_category = std::random_access_iterator_tag;
    using value_type = field;
    using difference_type = std::ptrdiff_t;
    using pointer = const field*;
    using reference = field;
    const_iterator() = default;
    const_iterator(const row* r, int col) : row_(r), col_(col) {}
    field operator*() const { return (*row_)[col_]; }
    const_iterator& operator++() {
      ++col_;
      return *this;
    }
    const_iterator operator++(int) {
      auto old = *this;
      ++col_;
      return old;
    }
    const_iterator& operator--() {
      --col_;
      return *this;
    }
    const_iterator& operator+=(difference_type n) {
      col_ += static_cast<int>(n);
      return *this;
    }
    const_iterator operator+(difference_type n) const { return {row_, col_ + static_cast<int>(n)}; }
    difference_type operator-(const const_iterator& o) const { return col_ - o.col_; }
    bool operator==(const const_iterator& o) const { return col_ == o.col_; }
    bool operator!=(const const_iterator& o) const { return col_ != o.col_; }

   private:
    const row* row_ = nullptr;
    int col_ = 0;
  };
  using iterator = const_iterator;

  row() = default;
  row(std::shared_ptr<const internal::result_data> data, int index) : data_(std::move(data)), index_(index) {}

  size_type size() const noexcept { return data_ ? static_cast<int>(data_->r.columns.size()) : 0; }
  bool empty() const noexcept { return size() == 0; }
  field operator[](int col) const noexcept { return field(data_, index_, col); }
  field operator[](zview name) const { return field(data_, index_, column_number(name)); }
  field operator[](const char* name) const { return (*this)[zview(name)]; }
  field operator[](const std::string& name) const { return (*this)[zview(name)]; }
  field at(int col) const;
  field at(zview name) const { return (*this)[name]; }
  field front() const { return (*this)[0]; }
  field back() const { return (*this)[size() - 1]; }
  const_iterator begin() const { return {this, 0}; }
  const_iterator end() const { return {this, size()}; }
  const_iterator cbegin() const { return begin(); }
  const_iterator cend() const { return end(); }
  int rownumber() const noexcept { return index_; }
  int num() const noexcept { return index_; }
  int column_number(zview name) const;
  oid column_type(int col) const { return data_->r.columns.at(static_cast<size_t>(col)).oid; }

  // The fields as a tuple of the given types: auto [id, name] = r.as<int, std::string>().
  template <class... T>
  std::tuple<T...> as() const {
    expect(static_cast<int>(sizeof...(T)));
    return as_tuple<T...>(std::index_sequence_for<T...>{});
  }
  template <class... T>
  void to(std::tuple<T...>& out) const {
    out = as<T...>();
  }

 private:
  void expect(int columns) const;
  template <class... T, std::size_t... I>
  std::tuple<T...> as_tuple(std::index_sequence<I...>) const {
    return std::tuple<T...>((*this)[static_cast<int>(I)].template as<T>()...);
  }
  std::shared_ptr<const internal::result_data> data_;
  int index_ = 0;
};

class result {
 public:
  using size_type = int;
  using difference_type = std::ptrdiff_t;
  using reference = row;

  class const_iterator {
   public:
    using iterator_category = std::random_access_iterator_tag;
    using value_type = row;
    using difference_type = std::ptrdiff_t;
    using pointer = const row*;
    using reference = row;
    const_iterator() = default;
    const_iterator(const result* r, int index) : result_(r), index_(index) {}
    row operator*() const { return (*result_)[index_]; }
    const_iterator& operator++() {
      ++index_;
      return *this;
    }
    const_iterator operator++(int) {
      auto old = *this;
      ++index_;
      return old;
    }
    const_iterator& operator--() {
      --index_;
      return *this;
    }
    const_iterator& operator+=(difference_type n) {
      index_ += static_cast<int>(n);
      return *this;
    }
    const_iterator operator+(difference_type n) const { return {result_, index_ + static_cast<int>(n)}; }
    difference_type operator-(const const_iterator& o) const { return index_ - o.index_; }
    bool operator==(const const_iterator& o) const { return index_ == o.index_; }
    bool operator!=(const const_iterator& o) const { return index_ != o.index_; }

   private:
    const result* result_ = nullptr;
    int index_ = 0;
  };
  using iterator = const_iterator;

  result() : data_(std::make_shared<internal::result_data>()) {}
  explicit result(std::shared_ptr<const internal::result_data> data) : data_(std::move(data)) {}

  size_type size() const noexcept { return static_cast<int>(data_->r.rows.size()); }
  bool empty() const noexcept { return data_->r.rows.empty(); }
  row operator[](int index) const noexcept { return row(data_, index); }
  row at(int index) const;
  row front() const noexcept { return (*this)[0]; }
  row back() const noexcept { return (*this)[size() - 1]; }
  const_iterator begin() const { return {this, 0}; }
  const_iterator end() const { return {this, size()}; }
  const_iterator cbegin() const { return begin(); }
  const_iterator cend() const { return end(); }

  // Rows an INSERT/UPDATE/DELETE changed (the rows returned, for a SELECT).
  size_type affected_rows() const;
  row_size_type columns() const noexcept { return static_cast<int>(data_->r.columns.size()); }
  const char* column_name(row_size_type n) const;
  row_size_type column_number(zview name) const;
  oid column_type(row_size_type n) const;
  const std::string& query() const noexcept { return data_->query; }

  // Row-count expectations (libpqxx 7.8): unexpected_rows otherwise.
  row one_row() const;
  std::optional<row> opt_row() const;
  field one_field() const;
  void no_rows() const;
  result expect_rows(size_type n) const;
  result expect_columns(row_size_type n) const;

  // Each row as a tuple of the given types: for (auto [id, name] : r.iter<int, std::string>()).
  template <class... T>
  std::vector<std::tuple<T...>> iter() const {
    std::vector<std::tuple<T...>> out;
    out.reserve(static_cast<size_t>(size()));
    for (const auto& r : *this) out.push_back(r.template as<T...>());
    return out;
  }

 private:
  std::shared_ptr<const internal::result_data> data_;
};

