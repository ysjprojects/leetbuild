class transaction_base;

class connection {
 public:
  connection() = default;
  explicit connection(const std::string& options) : options_(options) {}
  explicit connection(const char* options) : options_(options == nullptr ? "" : options) {}
  connection(const connection&) = delete;
  connection& operator=(const connection&) = delete;
  connection(connection&&) = default;
  connection& operator=(connection&&) = default;
  ~connection() = default;

  bool is_open() const noexcept { return open_; }
  void close() { open_ = false; }
  const char* dbname() const { return "app"; }
  const char* username() const { return "app"; }
  const char* hostname() const { return "db"; }
  const char* port() const { return "5432"; }
  const std::string& connection_string() const { return options_; }
  int server_version() const noexcept { return 160000; }
  int protocol_version() const noexcept { return 3; }
  int backendpid() const noexcept { return 1; }
  int sock() const noexcept { return 3; }

  // Prepared statements: exec_prepared(name, args…) runs definition with those parameters.
  void prepare(const std::string& name, const std::string& definition) { prepared_[name] = definition; }
  void prepare(const std::string& definition) { prepared_[""] = definition; }
  void unprepare(const std::string& name) { prepared_.erase(name); }
  const std::string& lb_prepared(const std::string& name) const;

  std::string esc(std::string_view text) const;
  std::string esc_raw(bytes_view data) const;
  std::string quote_raw(bytes_view data) const;
  std::string quote_name(std::string_view identifier) const;
  std::string quote_table(std::string_view name) const { return quote_name(name); }
  template <class T>
  std::string quote(const T& v) const {
    const lb::pg::Param p = lb::pg::to_param(v);
    if (!p.text) return "NULL";
    if (p.kind == 'y') return "'" + esc(*p.text) + "'::bytea";
    return "'" + esc(*p.text) + "'";
  }

  // @internal the transaction holding this connection, and its thread.
  transaction_base* lb_active = nullptr;
  int lb_owner = 0;

 private:
  std::string options_;
  bool open_ = true;
  std::map<std::string, std::string> prepared_;
};

// ---- transactions ---------------------------------------------------------------------------------

enum class isolation_level { read_committed, repeatable_read, serializable };
enum class write_policy { read_only, read_write };

class transaction_base {
 public:
  transaction_base(const transaction_base&) = delete;
  transaction_base& operator=(const transaction_base&) = delete;
  virtual ~transaction_base();

  // Make the transaction's work permanent (COMMIT) / undo it (ROLLBACK); either ends it.
  void commit();
  void abort();

  result exec(std::string_view query, std::string_view desc = {});
  result exec(std::string_view query, const params& args) { return run(std::string(query), args.lb_list()); }
  result exec(const prepped& statement, const params& args = {}) {
    return run(conn_.lb_prepared(statement.name()), args.lb_list());
  }
  result exec0(std::string_view query, std::string_view desc = {}) { return exec_n(0, query, desc); }
  row exec1(std::string_view query, std::string_view desc = {}) { return exec_n(1, query, desc).front(); }
  result exec_n(result::size_type rows, std::string_view query, std::string_view desc = {});

  template <class... A>
  result exec_params(std::string_view query, const A&... args) {
    return run(std::string(query), internal::params_of(args...));
  }
  template <class... A>
  result exec_params0(std::string_view query, const A&... args) {
    return expect(0, exec_params(query, args...));
  }
  template <class... A>
  row exec_params1(std::string_view query, const A&... args) {
    return expect(1, exec_params(query, args...)).front();
  }
  template <class... A>
  result exec_params_n(result::size_type rows, std::string_view query, const A&... args) {
    return expect(rows, exec_params(query, args...));
  }

  template <class... A>
  result exec_prepared(const std::string& statement, const A&... args) {
    return run(conn_.lb_prepared(statement), internal::params_of(args...));
  }
  template <class... A>
  result exec_prepared0(const std::string& statement, const A&... args) {
    return expect(0, exec_prepared(statement, args...));
  }
  template <class... A>
  row exec_prepared1(const std::string& statement, const A&... args) {
    return expect(1, exec_prepared(statement, args...)).front();
  }
  template <class... A>
  result exec_prepared_n(result::size_type rows, const std::string& statement, const A&... args) {
    return expect(rows, exec_prepared(statement, args...));
  }

  // Rows as tuples: for (auto [id, name] : tx.query<int, std::string>("SELECT id, name …")).
  template <class... T>
  std::vector<std::tuple<T...>> query(std::string_view q) {
    return exec(q).template iter<T...>();
  }
  template <class... T>
  std::vector<std::tuple<T...>> query(std::string_view q, const params& args) {
    return exec(q, args).template iter<T...>();
  }
  template <class... T>
  std::vector<std::tuple<T...>> stream(std::string_view q) {
    return query<T...>(q);
  }
  template <class... T>
  std::vector<std::tuple<T...>> query_n(result::size_type rows, std::string_view q) {
    return expect(rows, exec(q)).template iter<T...>();
  }
  template <class... T>
  std::tuple<T...> query1(std::string_view q) {
    return expect(1, exec(q)).front().template as<T...>();
  }
  template <class... T>
  std::tuple<T...> query1(std::string_view q, const params& args) {
    return expect(1, exec(q, args)).front().template as<T...>();
  }
  template <class... T>
  std::optional<std::tuple<T...>> query01(std::string_view q) {
    const result r = exec(q);
    if (r.size() > 1) expect(1, r);
    if (r.empty()) return std::nullopt;
    return r.front().template as<T...>();
  }
  template <class... T>
  std::optional<std::tuple<T...>> query01(std::string_view q, const params& args) {
    const result r = exec(q, args);
    if (r.size() > 1) expect(1, r);
    if (r.empty()) return std::nullopt;
    return r.front().template as<T...>();
  }
  // The single field of the single row as T.
  template <class T>
  T query_value(std::string_view q) {
    return value_of<T>(exec(q));
  }
  template <class T>
  T query_value(std::string_view q, const params& args) {
    return value_of<T>(exec(q, args));
  }

  std::string esc(std::string_view text) const { return conn_.esc(text); }
  std::string esc_raw(bytes_view data) const { return conn_.esc_raw(data); }
  std::string quote_raw(bytes_view data) const { return conn_.quote_raw(data); }
  std::string quote_name(std::string_view identifier) const { return conn_.quote_name(identifier); }
  template <class T>
  std::string quote(const T& v) const {
    return conn_.quote(v);
  }
  connection& conn() const noexcept { return conn_; }
  const std::string& name() const noexcept { return name_; }

 protected:
  // held: a real transaction (BEGIN … COMMIT on a held connection); begin: its BEGIN statement.
  transaction_base(connection& c, std::string name, bool held, std::string begin);
  void close() noexcept;

 private:
  result run(const std::string& query, const std::vector<lb::pg::Param>& args);
  result expect(result::size_type rows, const result& r) const;
  template <class T>
  T value_of(const result& r) {
    if (r.size() != 1) throw unexpected_rows("Queried single value from result with " + std::to_string(r.size()) + " rows.");
    if (r.columns() != 1)
      throw usage_error("Queried single value from result with " + std::to_string(r.columns()) + " columns.");
    return r.front()[0].template as<T>();
  }
  void end(const char* statement);

  connection& conn_;
  std::string name_;
  bool held_ = false;
  int hold_ = 0;
  bool done_ = false;
};

namespace internal {
const char* begin_command(isolation_level level, write_policy rw);
}

template <isolation_level ISOLATION = isolation_level::read_committed, write_policy READWRITE = write_policy::read_write>
class transaction : public transaction_base {
 public:
  explicit transaction(connection& c, std::string_view name = {})
      : transaction_base(c, std::string(name), true, internal::begin_command(ISOLATION, READWRITE)) {}
  ~transaction() override { close(); }
};

using work = transaction<>;
using read_transaction = transaction<isolation_level::read_committed, write_policy::read_only>;

// A "transaction" that is none: every statement commits on its own.
class nontransaction : public transaction_base {
 public:
  explicit nontransaction(connection& c, std::string_view name = {}) : transaction_base(c, std::string(name), false, "") {}
  ~nontransaction() override { close(); }
};

// libpqxx's robusttransaction: here as reliable as a plain transaction.
template <isolation_level ISOLATION = isolation_level::read_committed>
class robusttransaction : public transaction_base {
 public:
  explicit robusttransaction(connection& c, std::string_view name = {})
      : transaction_base(c, std::string(name), true, internal::begin_command(ISOLATION, write_policy::read_write)) {}
  ~robusttransaction() override { close(); }
};

