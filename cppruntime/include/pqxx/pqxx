// Character traits for std::byte (libc++ has none), as libpqxx 7.10 defines them for pqxx::bytes.
struct byte_char_traits : std::char_traits<char> {
  using char_type = std::byte;
  static void assign(std::byte& a, const std::byte& b) noexcept { a = b; }
  static std::byte* assign(std::byte* p, std::size_t n, std::byte b) noexcept {
    for (std::size_t i = 0; i < n; i++) p[i] = b;
    return p;
  }
  static bool eq(std::byte a, std::byte b) noexcept { return a == b; }
  static bool lt(std::byte a, std::byte b) noexcept { return a < b; }
  static int compare(const std::byte* a, const std::byte* b, std::size_t n) noexcept {
    for (std::size_t i = 0; i < n; i++) {
      if (a[i] != b[i]) return a[i] < b[i] ? -1 : 1;
    }
    return 0;
  }
  static std::size_t length(const std::byte*) { return 0; }
  static const std::byte* find(const std::byte* p, std::size_t n, const std::byte& b) noexcept {
    for (std::size_t i = 0; i < n; i++) {
      if (p[i] == b) return p + i;
    }
    return nullptr;
  }
  static std::byte* move(std::byte* to, const std::byte* from, std::size_t n) noexcept {
    if (n != 0) __builtin_memmove(to, from, n);
    return to;
  }
  static std::byte* copy(std::byte* to, const std::byte* from, std::size_t n) noexcept {
    if (n != 0) __builtin_memcpy(to, from, n);
    return to;
  }
  static std::byte to_char_type(int_type c) noexcept { return static_cast<std::byte>(c); }
  static int_type to_int_type(std::byte c) noexcept { return static_cast<int_type>(c); }
};

using bytes = std::basic_string<std::byte, byte_char_traits>;
using bytes_view = std::basic_string_view<std::byte, byte_char_traits>;

