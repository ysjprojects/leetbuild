// reflectOffsText holds the code addresses reflect registers (reflect_addReflectTextOff), by offset
// and back, under reflectOffs' lock (LeetBuild: goruntime/stdpatch). As uintptr, the collector never
// takes one for a heap pointer: on wasm a code address can lie inside the heap.
var (
	reflectOffsText    map[int32]uintptr
	reflectOffsTextInv map[uintptr]int32
)

// reflect_addReflectTextOff is reflect_addReflectOff for a code address (see reflectOffsText).
//
//go:linkname reflect_addReflectTextOff reflect.addReflectTextOff
func reflect_addReflectTextOff(ptr unsafe.Pointer) int32 {
	reflectOffsLock()
	if reflectOffs.m == nil {
		reflectOffs.m = make(map[int32]unsafe.Pointer)
		reflectOffs.minv = make(map[unsafe.Pointer]int32)
		reflectOffs.next = -1
	}
	if reflectOffsText == nil {
		reflectOffsText = make(map[int32]uintptr)
		reflectOffsTextInv = make(map[uintptr]int32)
	}
	pc := uintptr(ptr)
	id, found := reflectOffsTextInv[pc]
	if !found {
		id = reflectOffs.next
		reflectOffs.next-- // one sequence with reflect_addReflectOff's
		reflectOffsText[id] = pc
		reflectOffsTextInv[pc] = id
	}
	reflectOffsUnlock()
	return id
}

