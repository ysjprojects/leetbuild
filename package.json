{
  "name": "leetbuild",
  "version": "1.0.0",
  "private": true,
  "description": "LeetCode for systems: build an image cache, a match engine, a news feed… step by step in Python, Go, Scala or C++ across HTTPS, gRPC, Kafka and Redis.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "compile": "tsc --noEmit",
    "lint": "prettier --write './src/**/*.{ts,tsx,scss}' './scripts/**/*.ts' && eslint './src/**/*.{ts,tsx}' './scripts/**/*.ts' --fix --max-warnings=0",
    "verify": "tsx scripts/verify.ts",
    "protogen": "tsx scripts/protogen.ts",
    "build:runtime": "tsx scripts/build-runtime.ts",
    "predev": "yarn build:runtime",
    "prebuild": "yarn build:runtime"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@electric-sql/pglite": "0.5.9",
    "@lezer/highlight": "^1.2.3",
    "fengari": "0.1.5",
    "next": "14",
    "pyodide": "314.0.7",
    "react": "18",
    "react-dom": "18"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "14",
    "@tailwindcss/forms": "^0.5.0",
    "@tailwindcss/typography": "^0.5.2",
    "@types/node": "^17.0.21",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^5.14.0",
    "@typescript-eslint/parser": "^5.14.0",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.28.2",
    "eslint": "^8.10.0",
    "eslint-config-next": "14",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-react": "^7.29.3",
    "eslint-plugin-react-hooks": "^4.3.0",
    "eslint-plugin-react-memo": "^0.0.3",
    "eslint-plugin-simple-import-sort": "^7.0.0",
    "postcss": "^8.4.8",
    "prettier": "^2.5.1",
    "prettier-plugin-tailwindcss": "^0.1.8",
    "sass": "^1.49.9",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "5.5"
  },
  "resolutions": {
    "strip-ansi": "^6.0.1",
    "strip-ansi-cjs": "npm:strip-ansi@6.0.0"
  }
}
